---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="That page does not exist.">
  <section class="mx-auto max-w-5xl px-6 py-24 md:px-10 md:py-32">
    <h1 class="text-title font-medium">That page does not exist.</h1>
    <p class="measure body-copy mt-4">
      It may have belonged to an older version of this site.
    </p>
    <a href="/" class="btn btn-primary mt-8">Back to the work</a>
  </section>
</Base>
