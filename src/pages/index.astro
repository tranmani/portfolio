---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import { site } from "../lib/site";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const roles = (await getCollection("roles")).sort((a, b) => a.data.order - b.data.order);

const projectsRendered = await Promise.all(
  projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const rolesRendered = await Promise.all(
  roles.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const engagementLabel = {
  contract: "Contract",
  internship: "Internship",
  "part-time": "Part time",
  permanent: "",
} satisfies Record<string, string>;
---

<Base>
  <section class="mx-auto max-w-5xl px-6 pb-16 pt-16 md:px-10 md:pb-24 md:pt-20">
    <h1 class="max-w-4xl text-display font-medium">
      {site.name}
      <span class="block text-fg-subtle">{site.role}, {site.location}</span>
    </h1>

    <p class="measure body-copy mt-8 md:mt-10">{site.intro}</p>

    <p class="measure mt-6 text-lead">{site.availability}</p>

    {/* Mobile: buttons stack full width. Desktop: inline row. */}
    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <a href={`mailto:${site.email}`} class="btn btn-primary">Email me</a>
      <a href={site.cta.cv} class="btn btn-secondary">Read the CV</a>
      <a href={site.cta.github} class="btn btn-secondary">GitHub</a>
    </div>
  </section>

  <section id="work" class="border-t border-edge scroll-mt-4">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-10 md:py-24">
      <h2 class="text-title font-medium">Selected work</h2>

      <ul class="mt-14 flex list-none flex-col gap-24 p-0 md:gap-32">
        {
          projectsRendered.map(({ entry, Content }) => (
            <li>
              <article>
                <Rail sticky>
                  <Fragment slot="rail">
                    <span>{entry.data.role}</span>
                    <span>{entry.data.stack.join(" / ")}</span>
                    {entry.data.status && <span class="text-fg-muted">{entry.data.status}</span>}
                    {entry.data.links.map((l) => (
                      <a href={l.href} class="link-accent" target="_blank" rel="noopener">
                        {l.label}
                      </a>
                    ))}
                  </Fragment>

                  <h3 class="text-title font-medium">{entry.data.title}</h3>
                  <p class="measure mt-4 text-lead text-fg">{entry.data.hook}</p>

                  {entry.data.cover && entry.data.coverAlt && (
                    <Image
                      src={entry.data.cover}
                      alt={entry.data.coverAlt}
                      widths={[480, 900, 1350, 1800]}
                      sizes="(max-width: 768px) 100vw, 760px"
                      loading="lazy"
                      class="mt-8 w-full rounded-card border border-edge"
                    />
                  )}

                  <div class="measure mt-8 border-l-2 border-accent pl-5">
                    <div class="mono-meta">The hard problem</div>
                    <p class="body-copy mt-2">{entry.data.problem}</p>
                  </div>

                  <div class="measure body-copy mt-8">
                    <Content />
                  </div>

                  {entry.data.proof.length > 0 && (
                    <ul class="measure mt-10 flex list-none flex-col gap-3 border-t border-edge p-0 pt-6">
                      {entry.data.proof.map((p) => (
                        <li class="mono-meta text-fg-muted">{p}</li>
                      ))}
                    </ul>
                  )}
                </Rail>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="experience" class="border-t border-edge scroll-mt-4">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-10 md:py-24">
      <h2 class="text-title font-medium">Experience</h2>

      <ul class="mt-12 flex list-none flex-col p-0">
        {
          rolesRendered.map(({ entry, Content }) => (
            <li class="border-t border-edge py-8 first:border-t-0 first:pt-0">
              <Rail>
                <Fragment slot="rail">
                  <span>
                    {entry.data.start} to {entry.data.end}
                  </span>
                  <span>{entry.data.place}</span>
                </Fragment>

                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <h3 class="text-lead font-medium">{entry.data.title}</h3>
                  <span class="text-fg-muted">at {entry.data.company}</span>
                  {engagementLabel[entry.data.engagement] && (
                    <span class="mono-meta rounded-card border border-edge-strong px-1.5">
                      {engagementLabel[entry.data.engagement]}
                    </span>
                  )}
                  {entry.data.current && <span class="mono-meta text-live">Current</span>}
                </div>

                <div class="measure body-copy mt-2">
                  <Content />
                </div>

                {entry.data.note && <p class="mono-meta mt-3">{entry.data.note}</p>}
              </Rail>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contact" class="border-t border-edge scroll-mt-4">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-10 md:py-24">
      <h2 class="measure text-title font-medium">{site.availability}</h2>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a href={`mailto:${site.email}`} class="btn btn-primary">Email me</a>
        <a href={site.cta.linkedin} class="btn btn-secondary" target="_blank" rel="noopener">
          LinkedIn
        </a>
      </div>

      <p class="mono-meta mt-10">{site.email}</p>
    </div>
  </section>
</Base>
