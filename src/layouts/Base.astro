---
import "../styles/global.css";
import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} - ${site.role}, ${site.location}`, description = site.description } =
  Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isCv = Astro.url.pathname.startsWith("/cv");
const ogImage = new URL("/og.png", Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.toString(),
  email: `mailto:${site.email}`,
  address: { "@type": "PostalAddress", addressLocality: site.location, addressCountry: "NL" },
  sameAs: [site.cta.github, site.cta.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />

    {/* The display face renders the h1, which is the LCP element. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/space-grotesk-latin.woff2"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
      is:inline
    />

    {/* Microsoft Clarity. Async, so it never blocks the LCP; the CSP in
        vercel.json is what actually lets it reach clarity.ms. */}
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "vjbt90ua1x");
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:px-4 focus:py-2"
      style="background: var(--color-accent); color: var(--color-accent-fg);"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-10 border-b border-edge bg-bg/85 backdrop-blur">
      <nav
        aria-label="Primary"
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3 md:px-10"
      >
        <a href="/" class="font-medium">{site.name}</a>
        <ul class="flex list-none items-center gap-4 p-0 text-fg-muted sm:gap-5">
          <li><a href="/#work" class="nav-link" data-section="work">Work</a></li>
          <li>
            <a href="/#experience" class="nav-link" data-section="experience">Experience</a>
          </li>
          <li>
            <a href="/cv" class="nav-link" aria-current={isCv ? "page" : undefined}>CV</a>
          </li>
          <li><a href="/#contact" class="nav-link" data-section="contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* The site's own script, alongside the Clarity tag in the head. It marks the
        section you are currently in, and if it never runs the nav still works.
        No scroll listener: the observer fires only when a boundary is crossed. */}
    <script is:inline>
      (() => {
        const links = document.querySelectorAll(".nav-link[data-section]");
        if (!links.length) return;

        const byId = new Map();
        for (const link of links) byId.set(link.dataset.section, link);

        const sections = [...byId.keys()]
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        if (!sections.length) return;

        // A section is current while it crosses a thin band just under the header.
        // The band is the trick: observing whole sections only fires when one
        // enters or leaves the viewport, which never happens while you scroll
        // through a tall section, so the highlight would go stale.
        const active = new Set();

        const atBottom = () =>
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

        const paint = () => {
          // If two sections touch the band, the lower one is the one being entered.
          let current = null;
          for (const s of sections) if (active.has(s.id)) current = s;

          // The last section is short and sits at the foot of the page, so the
          // page runs out of scroll before it can reach the band. Once you are at
          // the bottom, you are looking at it, whatever the observer thinks.
          if (atBottom()) current = sections[sections.length - 1];

          for (const [id, link] of byId) {
            if (current && id === current.id) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          }
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) active.add(e.target.id);
              else active.delete(e.target.id);
            }
            paint();
          },
          { rootMargin: "-120px 0px -75% 0px" },
        );

        for (const s of sections) observer.observe(s);

        // Only to catch the bottom of the page, where no boundary is ever crossed.
        // Coalesced to one frame, passive, so it cannot make scrolling janky.
        let queued = false;
        addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              paint();
            });
          },
          { passive: true },
        );
      })();
    </script>

    <footer class="border-t border-edge">
      <div
        class="mono-meta mx-auto flex max-w-5xl flex-col gap-2 px-6 py-10 sm:flex-row sm:items-center sm:justify-between md:px-10"
      >
        <span>{site.name}, {site.location}</span>
        <span class="flex gap-5">
          <a href={`mailto:${site.email}`} class="hover:text-fg">Email</a>
          <a href={site.cta.linkedin} class="hover:text-fg" target="_blank" rel="noopener">
            LinkedIn
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
