---
import "../styles/global.css";
import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} - ${site.role}, ${site.location}`, description = site.description } =
  Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.toString(),
  email: `mailto:${site.email}`,
  address: { "@type": "PostalAddress", addressLocality: site.location, addressCountry: "NL" },
  sameAs: [site.cta.github, site.cta.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />

    {/* The display face renders the h1, which is the LCP element. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/space-grotesk-latin.woff2"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
      is:inline
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:px-4 focus:py-2"
      style="background: var(--color-accent); color: var(--color-accent-fg);"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-10 border-b border-edge bg-bg/85 backdrop-blur">
      <nav
        aria-label="Primary"
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3 md:px-10"
      >
        <a href="/" class="font-medium">{site.name}</a>
        <ul class="flex list-none items-center gap-5 p-0 text-fg-muted">
          <li><a href="/#work" class="hover:text-fg">Work</a></li>
          <li><a href="/#experience" class="hover:text-fg">Experience</a></li>
          <li><a href="/cv" class="hover:text-fg">CV</a></li>
          <li><a href="/#contact" class="hover:text-fg">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-edge">
      <div
        class="mono-meta mx-auto flex max-w-5xl flex-col gap-2 px-6 py-10 sm:flex-row sm:items-center sm:justify-between md:px-10"
      >
        <span>{site.name}, {site.location}</span>
        <span class="flex gap-5">
          <a href={`mailto:${site.email}`} class="hover:text-fg">Email</a>
          <a href={site.cta.linkedin} class="hover:text-fg" target="_blank" rel="noopener">
            LinkedIn
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
