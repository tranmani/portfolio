---
import "../styles/postcards.css";
import Seo from "../components/Seo.astro";
import { site } from "../lib/site";

/**
 * Shell for every page. The shared postcards look lives in postcards.css, and
 * each page adds its own pieces on top.
 */
interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD for this page, alongside the site-wide graph. */
  schema?: object[];
  /** For pages that should never be in an index, like the 404. */
  noindex?: boolean;
}

// "Almere" is where I live; "Amsterdam" is what a recruiter types into a search box.
const {
  title = `${site.name} - ${site.role}, Amsterdam area`,
  description = site.description,
  schema = [],
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} schema={schema} noindex={noindex} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/postcards/fraunces-latin-full-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/postcards/nunito-latin-wght-normal.woff2" />
    <slot name="head" />
  </head>

  <body class="pc">
    <a href="#main" class="pc-skip">Skip to content</a>
    <div class="blobs" aria-hidden="true"><span></span><span></span><span></span></div>
    <slot />
  </body>
</html>
