---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site } from "../lib/site";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const roles = (await getCollection("roles")).sort((a, b) => a.data.order - b.data.order);

const projectsRendered = await Promise.all(
  projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const rolesRendered = await Promise.all(
  roles.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const engagementLabel: Record<string, string> = {
  contract: "Contract",
  internship: "Internship",
  "part-time": "Part time",
  permanent: "",
};
---

<Base>
  {/* HERO. One screen: who, what I build, what I want, how to reach me. */}
  <section class="mx-auto max-w-5xl px-6 pb-20 pt-20 md:px-10 md:pb-28 md:pt-24">
    <h1 class="max-w-3xl text-[2.5rem] font-medium md:text-[3.5rem]">
      {site.name}
      <span class="block" style="color: var(--fg-subtle);">
        {site.role}, {site.location}
      </span>
    </h1>

    <p
      class="measure mt-8 text-[1.0625rem] md:mt-10 md:text-[1.25rem]"
      style="color: var(--fg-muted);"
    >
      {site.intro}
    </p>

    <p class="measure mt-6">{site.availability}</p>

    {/* Mobile: full width stacked buttons. Desktop: inline row. */}
    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center justify-center px-5 py-3 font-medium transition-transform duration-150 active:translate-y-px"
        style="background: var(--accent); color: var(--accent-fg); border-radius: var(--radius-card);"
      >
        Email me
      </a>
      <a
        href={site.cta.cv}
        class="inline-flex items-center justify-center border px-5 py-3 font-medium"
        style="border-color: var(--border-strong); border-radius: var(--radius-card);"
      >
        Download CV
      </a>
      <a
        href={site.cta.github}
        class="inline-flex items-center justify-center border px-5 py-3 font-medium"
        style="border-color: var(--border-strong); border-radius: var(--radius-card);"
        rel="noopener"
      >
        GitHub
      </a>
    </div>
  </section>

  {/* WORK. The case studies carry the page. */}
  <section class="border-t" style="border-color: var(--border);" aria-labelledby="work-heading">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-10 md:py-24">
      <h2 id="work-heading" class="text-[1.75rem] font-medium md:text-[2rem]">Selected work</h2>

      <ul class="mt-12 flex list-none flex-col gap-20 p-0 md:gap-28">
        {
          projectsRendered.map(({ entry, Content }) => (
            <li>
              <article>
                <div class="mono-meta flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span>{entry.data.year}</span>
                  <span aria-hidden="true">/</span>
                  <span>{entry.data.role}</span>
                </div>

                <h3 class="mt-3 text-[1.75rem] font-medium md:text-[2.25rem]">
                  {entry.data.title}
                </h3>

                <p class="measure mt-4 text-[1.125rem] md:text-[1.25rem]">{entry.data.hook}</p>

                {entry.data.cover && (
                  <Image
                    src={entry.data.cover}
                    alt={entry.data.coverAlt ?? ""}
                    widths={[480, 900, 1400]}
                    sizes="(max-width: 768px) 100vw, 900px"
                    loading="lazy"
                    class="mt-8 w-full border"
                    style="border-color: var(--border); border-radius: var(--radius-card);"
                  />
                )}

                {/* The constraint, set apart. It is what a senior reader scans for. */}
                <div class="measure mt-8 border-l-2 pl-5" style="border-color: var(--accent);">
                  <div class="mono-meta">The hard problem</div>
                  <p class="mt-2" style="color: var(--fg-muted);">
                    {entry.data.problem}
                  </p>
                </div>

                <div class="measure body-copy mt-8">
                  <Content />
                </div>

                {entry.data.proof.length > 0 && (
                  <ul class="measure mt-8 flex list-none flex-col gap-2 p-0">
                    {entry.data.proof.map((p) => (
                      <li class="flex gap-3">
                        <span
                          aria-hidden="true"
                          class="mt-[0.7em] h-px w-3 shrink-0"
                          style="background: var(--fg-subtle);"
                        />
                        <span style="color: var(--fg-muted);">{p}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                  {entry.data.links.map((l) => (
                    <a
                      href={l.href}
                      class="font-medium underline underline-offset-4"
                      style="color: var(--accent);"
                      rel="noopener"
                    >
                      {l.label}
                    </a>
                  ))}
                  <span class="mono-meta">{entry.data.stack.join(", ")}</span>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* EXPERIENCE. Engagement type is stated, so a three month role reads as a
      contract rather than as churn. */}
  <section class="border-t" style="border-color: var(--border);" aria-labelledby="exp-heading">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-10 md:py-24">
      <h2 id="exp-heading" class="text-[1.75rem] font-medium md:text-[2rem]">Experience</h2>

      <ul class="mt-10 flex list-none flex-col p-0">
        {
          rolesRendered.map(({ entry, Content }) => (
            <li
              class="border-t py-6 first:border-t-0 first:pt-0"
              style="border-color: var(--border);"
            >
              {/* Mobile: stacked. Desktop: dates hang in a metadata rail. */}
              <div class="flex flex-col gap-1 md:flex-row md:gap-10">
                <div class="mono-meta shrink-0 md:w-44 md:pt-1">
                  {entry.data.start} to {entry.data.end}
                </div>

                <div class="measure">
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                    <h3 class="text-[1.125rem] font-medium">{entry.data.title}</h3>
                    <span style="color: var(--fg-muted);">at {entry.data.company}</span>
                    {engagementLabel[entry.data.engagement] && (
                      <span
                        class="mono-meta border px-1.5"
                        style="border-color: var(--border-strong);"
                      >
                        {engagementLabel[entry.data.engagement]}
                      </span>
                    )}
                    {entry.data.current && (
                      <span class="mono-meta" style="color: var(--live);">
                        Current
                      </span>
                    )}
                  </div>

                  <div class="body-copy mt-2" style="color: var(--fg-muted);">
                    <Content />
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* CTA. The same ask as the hero, restated. One intent, one label. */}
  <section class="border-t" style="border-color: var(--border);">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-10 md:py-24">
      <h2 class="measure text-[1.75rem] font-medium md:text-[2rem]">{site.availability}</h2>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center justify-center px-5 py-3 font-medium transition-transform duration-150 active:translate-y-px"
          style="background: var(--accent); color: var(--accent-fg); border-radius: var(--radius-card);"
        >
          Email me
        </a>
        <a
          href={site.cta.linkedin}
          class="inline-flex items-center justify-center border px-5 py-3 font-medium"
          style="border-color: var(--border-strong); border-radius: var(--radius-card);"
          rel="noopener"
        >
          LinkedIn
        </a>
      </div>

      <p class="mono-meta mt-10">{site.email}</p>
    </div>
  </section>
</Base>
